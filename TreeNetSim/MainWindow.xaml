<Window x:Class="TreeNetSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TreeNetSim"
        mc:Ignorable="d"
        Title="Имитационная модель древовидной локальной сети"
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        MinWidth="1100" MinHeight="650"
        Loaded="Window_Loaded">

    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>

            <ColumnDefinition Width="*"/>

            <ColumnDefinition Width="270"/>

        </Grid.ColumnDefinitions>


        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="#263238" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Имитационная модель древовидной локальной сети"
                               Foreground="White" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>


                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnStart" Content="ПУСК"
                            Width="100" Height="36" Margin="0,0,8,0"
                            FontSize="13" FontWeight="Bold"
                            Background="#4CAF50" Foreground="White"
                            Style="{StaticResource FlatButton}"
                            Click="BtnStart_Click"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"/>

                    <Button x:Name="BtnReset" Content="СБРОС"
                            Width="90" Height="36" Margin="0,0,8,0"
                            FontSize="12"
                            Background="#FF9800" Foreground="White"
                            Style="{StaticResource FlatButton}"
                            Click="BtnReset_Click"/>

                    <Button x:Name="BtnHelp" Content="❓"
                            Width="40" Height="36" Margin="0,0,0,0"
                            FontSize="16"
                            Background="#607D8B" Foreground="White"
                            Style="{StaticResource FlatButton}"
                            Click="BtnHelp_Click"
                            ToolTip="Справка"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0"
                Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <StackPanel Grid.Row="0" Margin="12">

                    <TextBlock Text="ПАРАМЕТРЫ" FontSize="14" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,5"
                               Foreground="#263238"/>


                    <GroupBox Header="Канал связи" Margin="0,0,0,0" Padding="0">
                        <StackPanel>
                            <TextBlock Text="Скорость канала (Мбит/с):" FontSize="11" Margin="0,4,0,2"/>
                            <TextBox x:Name="TxtChannelSpeed" Text="100" Height="22" FontSize="12" Padding="5,3"/>

                            <TextBlock Text="Размер пакета (байт):" FontSize="11" Margin="0,8,0,2"/>
                            <TextBox x:Name="TxtPacketSize" Text="512" Height="22" FontSize="12" Padding="5,3"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Коммутаторы" Margin="0,0,0,0" Padding="0">
                        <StackPanel>
                            <TextBlock Text="Входная очередь (пакетов):" FontSize="11" Margin="0,4,0,2"/>
                            <TextBox x:Name="TxtSwitchQueueIn" Text="10" Height="22" FontSize="12" Padding="5,3"/>

                            <TextBlock Text="Выходная очередь (пакетов):" FontSize="11" Margin="0,8,0,2"/>
                            <TextBox x:Name="TxtSwitchQueueOut" Text="10" Height="22" FontSize="12" Padding="5,3"/>

                            <TextBlock Text="Время обработки (мс):" FontSize="11" Margin="0,8,0,2"/>
                            <TextBox x:Name="TxtSwitchProcessMs" Text="1.0" Height="22" FontSize="12" Padding="5,3"/>
                        </StackPanel>
                    </GroupBox>


                    <GroupBox Header="Режим генерации трафика" Margin="0,0,0,0" Padding="0">
                        <StackPanel>
                            <RadioButton x:Name="RbUniform" Content="Максимальной нагрузки"
                                         IsChecked="True" Margin="0,4"
                                         Checked="TrafficMode_Changed"/>

                            <RadioButton x:Name="RbMatrix" Content="Адресата"
                                         Margin="0,4"
                                         Checked="TrafficMode_Changed"/>


                            <StackPanel x:Name="PanelUniform" Visibility="Visible" Margin="0,0,0,0">
                                <TextBlock Text="Пакетов на станцию:" FontSize="11" Margin="0,4,0,2"/>
                                <TextBox x:Name="TxtPacketsPerStation" Text="20" Height="22" FontSize="12" Padding="5,3"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>


                    <GroupBox Header="Станции" Margin="0,0,0,0" Padding="0">
                        <StackPanel>
                            <TextBlock Text="Станций на ветвь:" FontSize="11" Margin="0,0,0,0"/>
                            <TextBox x:Name="TxtStationsPerBranch" Text="3" Height="22" FontSize="12" Padding="5,3"
                                     TextChanged="TxtStationsPerBranch_TextChanged"/>

                            <TextBlock Text="Интервал между пакетами (мс):" FontSize="11" Margin="0,0,0,0"/>
                            <TextBox x:Name="TxtPacketInterval" Text="5.0" Height="22" FontSize="12" Padding="5,3"/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>


                <Border Grid.Row="1" 
                        Background="White" 
                        BorderBrush="#CCCCCC" 
                        BorderThickness="1"
                        Margin="12,0,12,12"
                        CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="250"/>

                        </Grid.RowDefinitions>


                        <Border Grid.Row="0" Background="#2196F3" Padding="8,6" CornerRadius="5,5,0,0">
                            <TextBlock Text="Матрица трафика" 
                                       FontSize="12" FontWeight="Bold" 
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                        </Border>


                        <ScrollViewer Grid.Row="1" 
                                      HorizontalScrollBarVisibility="Auto" 
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="5">
                            <Grid x:Name="TrafficMatrixContainer"
                                  IsEnabled="False"
                                  Opacity="0.4"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top">
                                <Grid x:Name="MatrixGrid" Background="White"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
        </Border>


        <Border Grid.Row="1" Grid.Column="1" Margin="10"
                Background="White" BorderBrush="#DDDDDD"
                BorderThickness="1" CornerRadius="5">
            <Canvas x:Name="NetworkCanvas" Background="#FAFAFA"
                    SizeChanged="NetworkCanvas_SizeChanged"/>
        </Border>


        <Border Grid.Row="1" Grid.Column="2"
        Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <DockPanel Margin="12" LastChildFill="True">

                <TextBlock DockPanel.Dock="Top"
                   Text="РЕЗУЛЬТАТЫ" FontSize="14" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,5,0,15"
                   Foreground="#263238"/>

                <GroupBox DockPanel.Dock="Top" 
                  Header="Статистика моделирования" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <Border Background="#E3F2FD" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Среднее время доставки:"
                                   FontSize="10" Foreground="#555" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding AvgDeliveryText}"
                                   FontSize="18" FontWeight="Bold" Foreground="#2196F3"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFF3E0" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Время моделирования:"
                                   FontSize="10" Foreground="#555" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalSimTimeText}"
                                   FontSize="16" FontWeight="Bold" Foreground="#FF9800"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#E8F5E9" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Доставлено пакетов:"
                                   FontSize="10" Foreground="#555" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DeliveredText}"
                                   FontSize="16" FontWeight="Bold" Foreground="#4CAF50"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFEBEE" CornerRadius="5" Padding="10" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Отброшено пакетов:"
                                   FontSize="10" Foreground="#555" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DroppedText}"
                                   FontSize="16" FontWeight="Bold" Foreground="#F44336"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <Button DockPanel.Dock="Top"
                x:Name="BtnSave" Content="💾 Сохранить результаты"
                Height="38" Margin="0,0,0,10"
                FontSize="12" Background="#2196F3" Foreground="White"
                Style="{StaticResource FlatButton}" Padding="10"
                Click="BtnSave_Click"/>


                <Border Background="White" CornerRadius="5" 
                BorderBrush="#CCCCCC" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#263238" 
                        Padding="8,5" CornerRadius="5,5,0,0">
                            <Grid>
                                <TextBlock Text="Лог событий" 
                                   FontSize="11" FontWeight="Bold" 
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                                <Button x:Name="BtnClearLog" Content="✕"
                                HorizontalAlignment="Right"
                                Width="22" Height="22"
                                FontSize="10"
                                Background="#607D8B" Foreground="White"
                                Style="{StaticResource FlatButton}"
                                Click="BtnClearLog_Click"
                                ToolTip="Очистить лог"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" 
                              x:Name="LogScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="TxtLog"
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="#333333"
                               Background="#FAFAFA"
                               Padding="6,4"
                               TextWrapping="Wrap"
                               Text=""/>
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="#ECEFF1" 
                        Padding="6,3" CornerRadius="0,0,5,5">
                            <TextBlock x:Name="TxtLogCount" 
                               Text="Событий: 0" 
                               FontSize="9" 
                               Foreground="#607D8B"
                               HorizontalAlignment="Right"/>
                        </Border>
                    </Grid>
                </Border>

            </DockPanel>
        </Border>

    </Grid>
</Window>